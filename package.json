{
  "name": "smartrate",
  "version": "1.0.0",
  "description": "A Node.js rate limiter with fixed window, token bucket, sliding window algorithms, in-memory storage, and Redis-backed distributed rate limiting.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"src/test/**/*.test.js\" \"src/test/**/*.integration.js\"",
    "dev": "nodemon src/index.js"
  },

  "keywords": [
    "rate-limiter",
    "rate-limit",
    "rate-limiting",
    "nodejs",
    "throttle",
    "redis",
    "distributed-rate-limiter",
    "token-bucket",
    "fixed-window",
    "sliding-window",
    "middleware"
  ],

  "author": "vishuvd1122 <vishu.diwakar_cs22@gla.ac.in>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishuvd1122/SmartRate.git"
  },
  "bugs": {
    "url": "https://github.com/vishuvd1122/SmartRate/issues"
  },
  "homepage": "https://github.com/vishuvd1122/SmartRate#readme",
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "redis": "^4.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "^5.2.1",
    "nodemon": "^3.1.14",
    "redis": "^6.3.0",
    "supertest": "^7.2.2"
  }
}
